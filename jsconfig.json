{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["portal/**/*.js", "portal/types.d.ts"],
  "exclude": ["portal/vendor", "portal/tests"]
}
